{
  "name": "fiskl-help",
  "version": "1.0.1",
  "private": true,
  "scripts": {
    "docusaurus": "docusaurus",
    "start": "docusaurus start",
    "build": "docusaurus build",
    "swizzle": "docusaurus swizzle",
    "deploy": "docusaurus deploy",
    "clear": "docusaurus clear",
    "serve": "docusaurus serve",
    "write-translations": "docusaurus write-translations",
    "write-heading-ids": "docusaurus write-heading-ids",
    "typecheck": "tsc",
    "dev": "docusaurus start --port 3005",
    "create-page": "node scripts/manage-translation.js sync",
    "move-page": "node scripts/manage-translation.js move",
    "delete-page": "node scripts/manage-translation.js delete",
    "generate-doc": "tsx scripts/generate-docs-prompt.ts",
    "review-doc": "tsx scripts/review-docs-prompt.ts",
    "lint-docs": "node scripts/lint-docs.js",
    "convert-glossary": "node scripts/convert-glossary-links.js",
    "convert-glossary:all": "npm run convert-glossary docs && npm run convert-glossary i18n/fr/docusaurus-plugin-content-docs/current && npm run convert-glossary i18n/es/docusaurus-plugin-content-docs/current"
  },
  "dependencies": {
    "@docusaurus/core": "3.9.2",
    "@docusaurus/preset-classic": "3.9.2",
    "@docusaurus/theme-mermaid": "^3.9.2",
    "@easyops-cn/docusaurus-search-local": "^0.55.1",
    "@mdx-js/react": "^3.0.0",
    "@mermaid-js/layout-elk": "^0.2.0",
    "@signalwire/docusaurus-plugin-llms-txt": "^1.2.2",
    "clsx": "^2.0.0",
    "prism-react-renderer": "^2.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsx": "^4.21.0"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "3.9.2",
    "@docusaurus/tsconfig": "3.9.2",
    "@docusaurus/types": "3.9.2",
    "typescript": "~5.6.2"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  },
  "engines": {
    "node": ">=20.0"
  }
}